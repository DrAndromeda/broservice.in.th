# BroService.in.th — recommended Apache (.htaccess) additions.
# PROPOSAL ONLY: not part of the website, never uploaded automatically.
# Merge by hand with the live .htaccess after owner approval; test on a copy first.
# If Cloudflare sits in front, the same headers/caching can be set there instead.

# ---- Security headers (check CSP against any new third-party embed before enabling)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Pages use inline <style>/<script>, Google Fonts and one OpenStreetMap iframe (contacts page).
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline'; frame-src https://www.openstreetmap.org; connect-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
  # Enable only after confirming HTTPS works for every URL (browsers cache this for a year):
  # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# ---- Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml text/plain
</IfModule>

# ---- Caching (file names are not versioned, so keep static assets to 30 days)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
</IfModule>

# ---- Canonical host, HTTPS and trailing-slash policy (all URLs end with "/")
Options -Indexes
DirectorySlash On
<IfModule mod_rewrite.c>
  RewriteEngine On
  # one hop: http -> https and www -> apex together
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://broservice.in.th%{REQUEST_URI} [L,R=301]
  # explicit index.html -> directory URL
  RewriteCond %{THE_REQUEST} \s/(.*?)index\.html[\s?] [NC]
  RewriteRule ^(.*?)index\.html$ /$1 [L,R=301]
</IfModule>

# ---- Custom 404 must return a real 404 status
ErrorDocument 404 /404.html

# ---- Never serve internal files if they are ever uploaded by mistake
<FilesMatch "(\.md|\.py|\.sh|\.recommended)$">
  Require all denied
</FilesMatch>
